---
/**
 * Photo slideshow.
 *
 * Baseline without JavaScript: a CSS scroll-snap track that can be swiped and
 * scrolled natively, with every slide reachable. JavaScript then adds previous
 * and next controls, dot indicators, keyboard support, live-region
 * announcements and auto-advance.
 *
 * Auto-advance pauses on hover, on keyboard focus, when the tab is hidden, and
 * is disabled outright under `prefers-reduced-motion`.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import type { Photo } from '@/data/gallery';

interface Props {
  photos: readonly Photo[];
  /** Accessible name for the carousel region. */
  label: string;
  /** Milliseconds between automatic advances. */
  interval?: number;
}

const { photos, label, interval = 6000 } = Astro.props;
const total = photos.length;
---

<section
  class="relative"
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel
  data-interval={interval}
>
  <!-- Fixed aspect ratio: the frame is reserved before any image decodes,
       so switching slides can never shift the page. -->
  <div
    class="relative aspect-[4/3] w-full overflow-hidden rounded-lg bg-[var(--color-surface-3)] sm:aspect-[16/10] lg:aspect-[16/9]"
  >
    <div
      class="scroll-x flex h-full snap-x snap-mandatory [scrollbar-width:none] scroll-smooth [&::-webkit-scrollbar]:hidden"
      data-track
    >
      {
        photos.map((photo, i) => (
          <div
            class="relative h-full w-full shrink-0 snap-center snap-always"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}: ${photo.caption}`}
            data-slide
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={i === 0 ? [640, 960, 1440, 1920] : [512, 768, 1216]}
              sizes="(min-width: 1280px) 1216px, (min-width: 768px) 92vw, 100vw"
              quality={i === 0 ? 74 : 62}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              decoding={i === 0 ? 'sync' : 'async'}
              class="h-full w-full object-cover"
            />
            <p class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/45 to-transparent px-4 pt-12 pb-4 text-sm font-medium text-white sm:px-6 sm:pb-5 sm:text-base">
              {photo.caption}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Controls exist in the markup but stay hidden until scripting is
         confirmed, so a no-JS page never shows dead buttons. The reveal runs in
         an inline script below, during parse, so it costs no layout shift. -->
    <div class="hidden" data-controls>
      <button
        type="button"
        data-prev
        class="absolute top-1/2 left-2 inline-flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/55 text-white backdrop-blur-sm transition-colors duration-[var(--duration-micro)] hover:bg-black/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:left-3"
      >
        <span class="sr-only">Previous photo</span>
        <Icon name="lucide:chevron-left" class="size-6" aria-hidden="true" />
      </button>
      <button
        type="button"
        data-next
        class="absolute top-1/2 right-2 inline-flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-black/55 text-white backdrop-blur-sm transition-colors duration-[var(--duration-micro)] hover:bg-black/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-3"
      >
        <span class="sr-only">Next photo</span>
        <Icon name="lucide:chevron-right" class="size-6" aria-hidden="true" />
      </button>
      <button
        type="button"
        data-playpause
        class="absolute top-2 right-2 inline-flex size-11 cursor-pointer items-center justify-center rounded-full bg-black/55 text-white backdrop-blur-sm transition-colors duration-[var(--duration-micro)] hover:bg-black/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:top-3 sm:right-3"
        aria-pressed="false"
      >
        <span class="sr-only" data-playpause-label>Pause slideshow</span>
        <Icon name="lucide:pause" class="size-5" data-icon-pause aria-hidden="true" />
        <Icon name="lucide:play" class="hidden size-5" data-icon-play aria-hidden="true" />
      </button>
    </div>
  </div>

  <!-- Dot indicators -->
  <!-- Wraps rather than compressing: with many slides on a narrow viewport the
       dots must keep a >=24px target (WCAG 2.5.8) instead of shrinking to fit. -->
  <div class="mt-4 hidden flex-wrap items-center justify-center gap-1" data-dots>
    {
      photos.map((photo, i) => (
        <button
          type="button"
          data-dot={i}
          aria-current={i === 0 ? 'true' : undefined}
          class="group inline-flex size-8 cursor-pointer items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-ring)]"
        >
          <span class="sr-only">{`Show photo ${i + 1}: ${photo.caption}`}</span>
          <span
            aria-hidden="true"
            class="size-2.5 rounded-full border border-[var(--color-line-strong)] transition-all duration-[var(--duration-micro)] group-aria-[current=true]:w-6 group-aria-[current=true]:border-[var(--color-brand)] group-aria-[current=true]:bg-[var(--color-brand)]"
          />
        </button>
      ))
    }
  </div>

  <!-- Slide changes are announced without moving focus. -->
  <p class="sr-only" aria-live="polite" data-status></p>
</section>

<script is:inline>
  /* Runs during parse, before the carousel is painted, so revealing the
     JS-only controls does not shift anything. */
  (() => {
    const roots = document.querySelectorAll('[data-carousel]:not([data-revealed])');
    for (const root of roots) {
      root.setAttribute('data-revealed', '');
      if (root.querySelectorAll('[data-slide]').length < 2) continue;
      root.querySelector('[data-controls]')?.classList.remove('hidden');
      const dots = root.querySelector('[data-dots]');
      dots?.classList.remove('hidden');
      dots?.classList.add('flex');
    }
  })();
</script>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-carousel]');

  for (const root of carousels) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const controls = root.querySelector<HTMLElement>('[data-controls]');
    const dotsWrap = root.querySelector<HTMLElement>('[data-dots]');
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const status = root.querySelector<HTMLElement>('[data-status]');
    const playPause = root.querySelector<HTMLButtonElement>('[data-playpause]');
    const playPauseLabel = root.querySelector<HTMLElement>('[data-playpause-label]');
    const iconPause = root.querySelector<HTMLElement>('[data-icon-pause]');
    const iconPlay = root.querySelector<HTMLElement>('[data-icon-play]');

    if (!track || slides.length < 2) continue;

    /* The controls were already revealed by the inline script during parse; do
       it again defensively in case that script was blocked. */
    controls?.classList.remove('hidden');
    dotsWrap?.classList.remove('hidden');
    dotsWrap?.classList.add('flex');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const interval = Number(root.dataset['interval'] ?? 6000);
    const total = slides.length;

    let index = 0;
    let timer: number | undefined;
    /** User has explicitly paused; never auto-resume in that case. */
    let userPaused = false;
    let hovering = false;
    let focused = false;

    const goTo = (next: number, smooth = true) => {
      index = (next + total) % total;
      track.scrollTo({
        left: slides[index]!.offsetLeft - track.offsetLeft,
        behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto',
      });
      render();
    };

    const render = () => {
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (status) status.textContent = `Photo ${index + 1} of ${total}`;
    };

    /* ---- auto-advance ---- */
    const canRun = () =>
      !reduceMotion.matches && !userPaused && !hovering && !focused && !document.hidden;

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = () => {
      stop();
      if (!canRun()) return;
      timer = window.setInterval(() => goTo(index + 1), interval);
    };

    const syncPlayPause = () => {
      if (!playPause) return;
      const paused = userPaused || reduceMotion.matches;
      playPause.setAttribute('aria-pressed', String(paused));
      playPause.disabled = reduceMotion.matches;
      if (playPauseLabel) {
        playPauseLabel.textContent = reduceMotion.matches
          ? 'Slideshow paused because you prefer reduced motion'
          : paused
            ? 'Play slideshow'
            : 'Pause slideshow';
      }
      iconPause?.classList.toggle('hidden', paused);
      iconPlay?.classList.toggle('hidden', !paused);
      playPause.classList.toggle('opacity-50', reduceMotion.matches);
      playPause.classList.toggle('cursor-not-allowed', reduceMotion.matches);
    };

    playPause?.addEventListener('click', () => {
      userPaused = !userPaused;
      syncPlayPause();
      userPaused ? stop() : start();
    });

    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      goTo(index - 1);
      start();
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      goTo(index + 1);
      start();
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        goTo(i);
        start();
      })
    );

    /* ---- keyboard ---- */
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(total - 1);
      }
    });

    /* ---- pause triggers ---- */
    root.addEventListener('pointerenter', () => {
      hovering = true;
      stop();
    });
    root.addEventListener('pointerleave', () => {
      hovering = false;
      start();
    });
    root.addEventListener('focusin', () => {
      focused = true;
      stop();
    });
    root.addEventListener('focusout', () => {
      focused = false;
      start();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduceMotion.addEventListener('change', () => {
      syncPlayPause();
      start();
    });

    /* ---- keep index in sync with native swipe/scroll ---- */
    let scrollDebounce: number | undefined;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(scrollDebounce);
        scrollDebounce = window.setTimeout(() => {
          const mid = track.scrollLeft + track.clientWidth / 2;
          const nearest = slides.reduce(
            (best, slide, i) => {
              const centre = slide.offsetLeft - track.offsetLeft + slide.clientWidth / 2;
              const d = Math.abs(centre - mid);
              return d < best.d ? { i, d } : best;
            },
            { i: 0, d: Infinity }
          );
          if (nearest.i !== index) {
            index = nearest.i;
            render();
          }
        }, 120);
      },
      { passive: true }
    );

    /* ---- only run while the carousel is actually on screen ---- */
    new IntersectionObserver(
      (entries) => {
        for (const entry of entries) entry.isIntersecting ? start() : stop();
      },
      { threshold: 0.35 }
    ).observe(root);

    syncPlayPause();
    render();
  }
</script>
