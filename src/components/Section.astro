---
/** Vertical rhythm wrapper: one place that owns section spacing and headings. */
import ContourBackdrop from '@/components/ContourBackdrop.astro';

interface Props {
  id?: string;
  /** Draws faint topographic contours behind the section. */
  pattern?: boolean;
  title?: string;
  eyebrow?: string;
  lead?: string;
  /** Tints the section so alternating bands read as distinct. */
  tone?: 'plain' | 'muted';
  /** Heading level, so pages never skip a level. */
  as?: 'h2' | 'h3';
  class?: string;
}

const {
  id,
  title,
  eyebrow,
  lead,
  tone = 'plain',
  as = 'h2',
  pattern = false,
  class: className = '',
} = Astro.props as Props;
const Heading = as;
---

<section
  id={id}
  class:list={[
    'py-14 md:py-20',
    pattern && 'relative isolate overflow-hidden',
    tone === 'muted' && 'border-y border-[var(--color-line)] bg-[var(--color-surface-2)]',
    className,
  ]}
>
  {pattern && <ContourBackdrop class="-z-10" />}
  <div class="container-page">
    {
      (eyebrow || title || lead) && (
        <div class="mb-10 max-w-2xl md:mb-12">
          {eyebrow && (
            <p class="text-2xs mb-3 font-sans font-bold tracking-[0.16em] text-[var(--color-brand)] uppercase">
              {eyebrow}
            </p>
          )}
          {title && <Heading class="text-3xl">{title}</Heading>}
          {lead && <p class="mt-4 text-lg text-[var(--color-ink-muted)]">{lead}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>
