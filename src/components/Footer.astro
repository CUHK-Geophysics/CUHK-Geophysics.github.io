---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import logo from '@/assets/brand/logo.png';
import { addressLines, contact, nav, piEmail, site } from '@/lib/site';
import { href } from '@/lib/url';

const year = new Date().getFullYear();
const labAddress = addressLines(contact.lab.room);
---

<footer class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-surface-2)]">
  <div class="container-page py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      <!-- Identity -->
      <div>
        <div class="flex items-start gap-3">
          <Image
            src={logo}
            alt=""
            width={48}
            height={48}
            densities={[1, 2]}
            loading="lazy"
            class="size-12 shrink-0"
            aria-hidden="true"
          />
          <div>
            <p class="font-serif text-lg font-semibold text-[var(--color-ink)]">
              {site.longName}
            </p>
            <p class="text-sm text-[var(--color-ink-muted)]">{site.tagline}</p>
          </div>
        </div>
        <p class="mt-4 max-w-xs text-sm text-[var(--color-ink-muted)]">
          <a
            href={site.department.url}
            class="underline decoration-1 underline-offset-2 hover:text-[var(--color-brand)]"
          >
            {site.department.name}
          </a>{', '}
          <a
            href={site.university.url}
            class="underline decoration-1 underline-offset-2 hover:text-[var(--color-brand)]"
          >
            {site.university.name}
          </a>
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h2
          class="text-2xs font-sans font-bold tracking-[0.14em] text-[var(--color-ink)] uppercase"
        >
          Explore
        </h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2.5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={href(item.href)}
                  class="text-[var(--color-ink-muted)] underline decoration-1 underline-offset-2 hover:text-[var(--color-brand)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h2
          class="text-2xs font-sans font-bold tracking-[0.14em] text-[var(--color-ink)] uppercase"
        >
          Find us
        </h2>
        <address class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)] not-italic">
          {
            labAddress.map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
              </Fragment>
            ))
          }
        </address>
        <ul class="mt-3 space-y-1.5 text-sm">
          <li>
            <a
              href={`mailto:${piEmail}`}
              class="text-[var(--color-brand)] underline decoration-1 underline-offset-2 hover:text-[var(--color-brand-strong)]"
            >
              {piEmail}
            </a>
          </li>
          <li>
            <a
              href={href('/contact')}
              class="text-[var(--color-brand)] underline decoration-1 underline-offset-2 hover:text-[var(--color-brand-strong)]"
            >
              Contact us
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-[var(--color-line)] pt-6 text-xs text-[var(--color-ink-subtle)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.longName}, {site.university.name}.</p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li>
          <a
            href={site.org}
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-[var(--color-brand)] underline decoration-1 underline-offset-2 hover:text-[var(--color-brand-strong)]"
          >
            <Icon name="lucide:github" class="size-3.5" aria-hidden="true" />
            CUHK-Geophysics on GitHub
          </a>
        </li>
        <li>
          <a
            href={site.repo}
            rel="noopener"
            class="text-[var(--color-brand)] underline decoration-1 underline-offset-2 hover:text-[var(--color-brand-strong)]"
          >
            Website source
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
