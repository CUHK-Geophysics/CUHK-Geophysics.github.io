---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Section from '@/components/Section.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import { alumni } from '@/data/team';
import PageLayout from '@/layouts/PageLayout.astro';
import { formatJoined, groupByTrack, resolveSocials, trackLabels } from '@/lib/members';
import { piEmail, site } from '@/lib/site';
import { href } from '@/lib/url';

/*
 * People come from Markdown so the group can maintain their own entries — see
 * docs/ADD-A-MEMBER.md. The PI is one of those files too, marked `track: pi`,
 * and is pulled out here to be rendered by the featured card.
 */
const all = await getCollection('members');
const pi = all.find((m) => m.data.track === 'pi');
if (!pi) throw new Error('No member file has `track: pi`; the team page needs one.');

const grouped = groupByTrack(all.filter((m) => m.data.track !== 'pi'));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Team — ${site.longName}`,
  about: [
    {
      '@type': 'Person',
      name: pi.data.name,
      jobTitle: pi.data.role,
      email: piEmail,
      ...(pi.data.socials?.profile ? { url: pi.data.socials.profile } : {}),
      worksFor: { '@type': 'CollegeOrUniversity', name: site.university.name },
    },
    ...all
      .filter((m) => m.data.track !== 'pi')
      .map((m) => ({
        '@type': 'Person',
        name: m.data.name,
        jobTitle: m.data.role,
        worksFor: { '@type': 'CollegeOrUniversity', name: site.university.name },
      })),
  ],
};
---

<PageLayout
  title="Team"
  heading="The group"
  eyebrow="People"
  lead="We welcome people of any race, ethnicity, religion, national origin, gender identity, gender expression, caregiver and family commitments, political affiliation, sexual orientation, age or disability status."
  description="Members of the CUHK Geophysics Laboratory: principal investigator, research faculty, postdoctoral researchers, graduate students and alumni."
  structuredData={structuredData}
>
  <!-- ===================== Principal investigator ===================== -->
  <Section eyebrow="Principal investigator">
    <article
      class="grid gap-8 rounded-lg border border-[var(--color-line)] bg-[var(--color-surface-2)] p-6 sm:grid-cols-[13rem_minmax(0,1fr)] sm:p-8 md:gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]"
    >
      <Image
        src={pi.data.photo}
        alt={`Portrait of ${pi.data.name}`}
        widths={[256, 384, 512]}
        sizes="(min-width: 1024px) 256px, (min-width: 640px) 208px, 60vw"
        loading="eager"
        class="aspect-square w-full max-w-[13rem] rounded-md object-cover sm:max-w-none"
      />

      <div>
        <h2 class="text-2xl">
          {pi.data.name}{pi.data.qualification ? `, ${pi.data.qualification}` : ''}
          {
            pi.data.nameChinese && (
              <span lang="zh-Hant" class="ml-1.5 font-normal text-[var(--color-ink-muted)]">
                ({pi.data.nameChinese})
              </span>
            )
          }
        </h2>
        <p class="mt-1 font-bold text-[var(--color-brand)]">{pi.data.role}</p>
        <p class="mt-4 max-w-xl leading-relaxed text-[var(--color-ink-muted)]">
          {pi.data.interest}
        </p>
        {pi.data.bio && <p class="mt-3 max-w-xl text-[var(--color-ink-muted)]">{pi.data.bio}</p>}

        <dl class="mt-6 space-y-2 text-sm">
          {
            pi.data.office && (
              <div class="flex flex-wrap gap-x-2">
                <dt class="font-bold text-[var(--color-ink)]">Office</dt>
                <dd class="text-[var(--color-ink-muted)]">{pi.data.office}</dd>
              </div>
            )
          }
          <div class="flex flex-wrap gap-x-2">
            <dt class="font-bold text-[var(--color-ink)]">Email</dt>
            <dd>
              <a
                href={`mailto:${piEmail}`}
                class="text-[var(--color-brand)] underline decoration-1 underline-offset-2 hover:text-[var(--color-brand-strong)]"
                >{piEmail}</a
              >
            </dd>
          </div>
        </dl>

        <SocialLinks socials={pi.data.socials} personName={pi.data.name} class="mt-5" />
      </div>
    </article>
  </Section>

  <!-- ========================= Group members ========================= -->
  <Section tone="muted" title="Group members" id="members">
    <!-- One continuous grid across all tracks: a track with a single member
         then sits in the same column rhythm as the rest, instead of getting a
         near-empty full-width band of its own. -->
    <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        grouped.map(({ track, people }) => (
          <Fragment>
            <h3
              id={track}
              class="text-2xs col-span-full scroll-mt-24 border-b border-[var(--color-line)] pb-2 font-sans font-bold tracking-[0.14em] text-[var(--color-ink)] uppercase"
            >
              {trackLabels[track]}
              <span class="ml-2 font-normal text-[var(--color-ink-subtle)] tabular-nums">
                ({people.length})
              </span>
            </h3>
            {people.map((member) => (
              <article
                class="flex h-full flex-col overflow-hidden rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)]"
                id={member.id}
              >
                <Image
                  src={member.data.photo}
                  alt={`Portrait of ${member.data.name}`}
                  widths={[240, 360, 480]}
                  sizes="(min-width: 1280px) 260px, (min-width: 1024px) 300px, (min-width: 640px) 44vw, 88vw"
                  loading="lazy"
                  class="aspect-square w-full object-cover"
                />
                <div class="flex flex-1 flex-col p-5">
                  <h4 class="font-serif text-lg leading-snug font-semibold text-balance">
                    {member.data.name}
                    {member.data.nameChinese && (
                      <span lang="zh-Hant" class="font-normal text-[var(--color-ink-muted)]">
                        {' '}
                        ({member.data.nameChinese})
                      </span>
                    )}
                  </h4>
                  <p class="mt-1 text-sm font-bold text-[var(--color-brand)]">{member.data.role}</p>
                  <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                    {member.data.interest}
                  </p>
                  {member.data.bio && (
                    <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-subtle)]">
                      {member.data.bio}
                    </p>
                  )}

                  {/* Pushes the metadata row to the bottom so cards of
                      differing text length still line their footers up. */}
                  <div class="flex-1" />

                  <p class="mt-4 flex items-center gap-1.5 text-xs text-[var(--color-ink-subtle)]">
                    <Icon name="lucide:calendar" class="size-3.5 shrink-0" aria-hidden="true" />
                    In the group since {formatJoined(member.data.joined)}
                  </p>

                  {resolveSocials(member.data.socials).length > 0 && (
                    <div class="mt-4 border-t border-[var(--color-line)] pt-4">
                      <SocialLinks socials={member.data.socials} personName={member.data.name} />
                    </div>
                  )}
                </div>
              </article>
            ))}
          </Fragment>
        ))
      }
    </div>
  </Section>

  <!-- ============================= Alumni ============================= -->
  <Section id="alumni" title="Alumni" lead="Former members of the group, and where they went next.">
    <ol class="divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
      {
        alumni.map((person) => (
          <li class="grid gap-1 py-5 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] sm:gap-6">
            <p class="font-serif text-lg font-semibold">{person.name}</p>
            <div class="text-sm text-[var(--color-ink-muted)]">
              <p>{person.tenure}</p>
              {person.next && (
                <p class="mt-1 text-[var(--color-ink)]">
                  <span class="text-[var(--color-ink-subtle)]">Now:</span> {person.next}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- ============================= Join CTA ============================= -->
  <Section>
    <div
      class="rounded-lg border border-[var(--color-line)] bg-[var(--color-brand-wash)] p-8 md:p-10"
    >
      <h2 class="text-2xl">Interested in joining us?</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-[var(--color-ink-muted)]">
        We typically welcome one to two new group members each year, and we welcome applicants from
        {' '}
        <strong class="text-[var(--color-ink)]">all</strong> backgrounds. If your interests look like
        a good fit, please get in touch.
      </p>
      <p class="mt-6">
        <a
          href={href('/join')}
          class="inline-flex min-h-11 items-center gap-2 rounded-md bg-[var(--color-brand)] px-5 text-[0.9375rem] font-bold text-[var(--color-on-brand)] transition-colors duration-[var(--duration-micro)] hover:bg-[var(--color-brand-strong)]"
        >
          Opportunities and how to apply
          <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </p>
    </div>
  </Section>
</PageLayout>
