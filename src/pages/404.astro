---
import { Icon } from 'astro-icon/components';

import Button from '@/components/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { nav } from '@/lib/site';
import { href } from '@/lib/url';
---

<BaseLayout title="Page not found" description="The page you requested could not be found.">
  <div class="container-page py-20 md:py-28">
    <p class="text-2xs font-sans font-bold tracking-[0.16em] text-[var(--color-brand)] uppercase">
      Error 404
    </p>
    <h1 class="mt-3 text-4xl">This page could not be found</h1>
    <p class="mt-4 max-w-xl text-lg text-[var(--color-ink-muted)]">
      The address may be mistyped, or the page may have moved when the site was rebuilt. The
      sections below cover everything on the site.
    </p>

    <div class="mt-8">
      <Button href={href('/')}>
        <Icon name="lucide:arrow-left" class="size-4" aria-hidden="true" />
        Back to the homepage
      </Button>
    </div>

    <nav class="mt-12 border-t border-[var(--color-line)] pt-8" aria-label="All sections">
      <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.href)}
                class="text-[var(--color-brand)] underline decoration-1 underline-offset-2 hover:text-[var(--color-brand-strong)]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>
