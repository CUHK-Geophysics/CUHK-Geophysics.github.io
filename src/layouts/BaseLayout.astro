---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import { site } from '@/lib/site';
import { href } from '@/lib/url';
import '@/styles/global.css';

/* The two faces that render above the fold. Preloading them breaks the
   HTML -> CSS -> font request chain, so the swap happens in the first frame
   instead of one round trip later. Vite resolves these to hashed build URLs. */
import bodyFont from '@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url';
import displayFont from '@fontsource-variable/crimson-pro/files/crimson-pro-latin-wght-normal.woff2?url';

interface Props {
  /** Page title, without the site suffix. */
  title: string;
  description?: string;
  /** JSON-LD to embed for this page. */
  structuredData?: Record<string, unknown>;
  /** Suppress the site-name suffix (used by the homepage). */
  bareTitle?: boolean;
}

const { title, description = site.description, structuredData, bareTitle = false } = Astro.props;

const fullTitle = bareTitle ? title : `${title} · ${site.longName} @ ${site.university.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://cuhk-geophysics.github.io');
const ogImage = new URL(href('/og-image.png'), canonical);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta name="theme-color" content="#750f6d" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous" />

    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.longName} @ ${site.university.shortName}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <ThemeScript />

    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>

  <body class="min-h-dvh bg-[var(--color-surface)] text-[var(--color-ink)] antialiased">
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
